# Public production URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery — configure ONE of these. Without them the form reports
# that delivery is not configured (it never fakes a success).
# Option A: forward submissions as JSON to a webhook (Zapier, Make, your CRM, etc.)
CONTACT_WEBHOOK_URL=
# Option B: send via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Sanity CMS — see README → "Sanity CMS"
NEXT_PUBLIC_SANITY_PROJECT_ID=x7hz1fx7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Optional: Viewer token (only needed if the dataset is made private)
SANITY_API_READ_TOKEN=
# Editor token — only for `node --env-file=.env.local scripts/seed-sanity.mjs`; remove afterwards
SANITY_API_WRITE_TOKEN=
# Any long random text; paste the same value into the Sanity webhook's "Secret"
SANITY_REVALIDATE_SECRET=
