# Public production URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact form delivery — configure ONE of these. Without them the form reports
# that delivery is not configured (it never fakes a success).
# Option A: forward submissions as JSON to a webhook (Zapier, Make, your CRM, etc.)
CONTACT_WEBHOOK_URL=
# Option B: send via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Sanity CMS — see README → "Sanity CMS"
NEXT_PUBLIC_SANITY_PROJECT_ID=2b5hsmi7
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Optional: Viewer token (only needed if the dataset is made private)
SANITY_API_READ_TOKEN=
# Editor token (server only, never public). Used by the seed script AND to save
# contact-form messages into the studio's Enquiries inbox — keep it set in Vercel.
SANITY_API_WRITE_TOKEN=
# Any long random text; paste the same value into the Sanity webhook's "Secret"
SANITY_REVALIDATE_SECRET=

# CAPTCHA on the contact form — Google reCAPTCHA: https://www.google.com/recaptcha/admin
# Register your domains (and "localhost" for testing). Choose v2 ("I'm not a robot"
# checkbox) or v3 (invisible score) — keys only work with the version you chose.
# Leave the keys empty to turn the CAPTCHA off.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_VERSION=v2
